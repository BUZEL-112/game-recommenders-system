# -----------------------------------------------------------------------------
# Terraform Providers Configuration
# -----------------------------------------------------------------------------
# This file configures the cloud providers required for deploying the
# Game Recommender System container from Docker Hub.
# -----------------------------------------------------------------------------

terraform {
  required_version = ">= 1.0.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

provider "aws" {
  region = var.aws_region

  default_tags {
    tags = {
      Project     = var.project_name
      Environment = var.environment
      ManagedBy   = "Terraform"
    }
  }
}
